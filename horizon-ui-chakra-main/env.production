# Production Environment Variables for RENDER
# ============================================

# API Configuration
REACT_APP_API_URL=https://smd-vital-backend.onrender.com
REACT_APP_API_BASE_URL=https://smd-vital-backend.onrender.com

# Build Configuration
GENERATE_SOURCEMAP=false
DISABLE_ESLINT_PLUGIN=true
NODE_ENV=production

# Google OAuth Configuration (you'll need to set these in RENDER)
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here
REACT_APP_GOOGLE_REDIRECT_URI=https://smd-vital-frontend.onrender.com/auth/callback
