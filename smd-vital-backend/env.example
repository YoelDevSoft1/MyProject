# SMD Vital Backend - Environment Configuration
# ============================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql+asyncpg://smdvital:smdvital_password_2024@localhost:5432/smdvital
POSTGRES_DB=smdvital
POSTGRES_USER=smdvital
POSTGRES_PASSWORD=smdvital_password_2024

# Redis Configuration
REDIS_URL=redis://:redis_password_2024@localhost:6379/0
REDIS_PASSWORD=redis_password_2024

# JWT Configuration
JWT_SECRET_KEY=super_secret_jwt_key_for_smd_vital_2024_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,https://smdvitalbogota.com
ALLOWED_HOSTS=localhost,127.0.0.1,*.smdvitalbogota.com

# Email Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
EMAIL_FROM=noreply@smdvitalbogota.com
EMAIL_FROM_NAME=SMD Vital Bogotá

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# WhatsApp Business API
WHATSAPP_TOKEN=your_whatsapp_business_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id

# Payment Gateways
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
PSE_MERCHANT_ID=your_pse_merchant_id
PSE_API_KEY=your_pse_api_key

# External Services URLs
AUTH_SERVICE_URL=http://localhost:8001
USER_SERVICE_URL=http://localhost:8002
APPOINTMENT_SERVICE_URL=http://localhost:8003
NOTIFICATION_SERVICE_URL=http://localhost:8004
MEDICAL_RECORDS_SERVICE_URL=http://localhost:8005
PAYMENT_SERVICE_URL=http://localhost:8006

# Frontend URL
FRONTEND_URL=http://localhost:5173
