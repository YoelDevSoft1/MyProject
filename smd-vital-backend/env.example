# SMD Vital - Environment Variables
# =================================
# Copy this file to .env and update the values

# Database Configuration
DATABASE_URL=postgresql://smdvital:password@postgres:5432/smdvital
POSTGRES_DB=smdvital
POSTGRES_USER=smdvital
POSTGRES_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://:redis_password_2024@redis:6379/0
REDIS_PASSWORD=redis_password_2024

# RabbitMQ Configuration
RABBITMQ_URL=amqp://smdvital:password@rabbitmq:5672/smdvital
RABBITMQ_USER=smdvital
RABBITMQ_PASSWORD=password
RABBITMQ_VHOST=smdvital

# Celery Configuration
CELERY_BROKER_URL=amqp://smdvital:password@rabbitmq:5672/smdvital
CELERY_RESULT_BACKEND=redis://redis:6379/3
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=True

# Service Discovery URLs
AUTH_SERVICE_URL=http://auth-service:8001
USER_SERVICE_URL=http://user-service:8002
APPOINTMENT_SERVICE_URL=http://appointment-service:8003
NOTIFICATION_SERVICE_URL=http://notification-service:8004
MEDICAL_RECORDS_SERVICE_URL=http://medical-records-service:8005
PAYMENT_SERVICE_URL=http://payment-service:8006

# Security
SECRET_KEY=your-super-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=smdvital_grafana_2024
GRAFANA_SECRET_KEY=smdvital_grafana_secret_key_2024

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=True
MAIL_FROM_NAME=SMD Vital
MAIL_FROM_EMAIL=noreply@smdvital.com

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
SMS_API_URL=https://api.twilio.com/2010-04-01/Accounts
SMS_SENDER_ID=SMDVITAL

# WhatsApp Configuration
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_URL=https://graph.facebook.com/v17.0

# Payment Configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
PSE_MERCHANT_ID=your-pse-merchant-id
PSE_API_KEY=your-pse-api-key

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx
UPLOAD_FOLDER=uploads

# Monitoring and Observability
PROMETHEUS_GATEWAY=http://prometheus:9090
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831
ELASTICSEARCH_URL=http://elasticsearch:9200
LOG_LEVEL=INFO

# Flower Configuration
FLOWER_BASIC_AUTH=admin:smdvital123
FLOWER_URL_PREFIX=/flower

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Caching
CACHE_TTL=3600  # 1 hour
CACHE_MAX_SIZE=1000

# Development/Production
ENVIRONMENT=development
DEBUG=True
FLASK_ENV=development

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

# SSL Configuration (for production)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Notification Templates
EMAIL_TEMPLATE_PATH=templates/email
SMS_TEMPLATE_PATH=templates/sms
WHATSAPP_TEMPLATE_PATH=templates/whatsapp

# Feature Flags
FEATURE_AI_ASSISTANT=True
FEATURE_TELEMEDICINE=True
FEATURE_PAYMENT_PROCESSING=True
FEATURE_NOTIFICATION_SYSTEM=True
FEATURE_ANALYTICS=True

# API Keys for External Services
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_ANALYTICS_ID=your-google-analytics-id
SENTRY_DSN=your-sentry-dsn

# Database Pool Configuration
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Worker Configuration
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ACKS_LATE=True
CELERY_WORKER_DISABLE_RATE_LIMITS=False
CELERY_TASK_COMPRESSION=gzip
CELERY_RESULT_COMPRESSION=gzip
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240