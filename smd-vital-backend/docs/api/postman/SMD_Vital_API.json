              "raw": "{\n  \"patient_id\": \"{{patientId}}\",\n  \"appointment_id\": \"{{appointmentId}}\",\n  \"chief_complaint\": \"Dolor abdominal intenso\",\n  \"present_illness\": \"Paciente refiere dolor abdominal de 2 días de evolución\",\n  \"physical_examination\": \"Abdomen blando, depresible, dolor en epigastrio\",\n  \"assessment\": \"Gastritis aguda probable\",\n  \"plan\": \"Omeprazol 20mg cada 12 horas por 7 días, dieta blanda\"\n}"
