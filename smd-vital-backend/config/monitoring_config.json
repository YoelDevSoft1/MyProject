{
  "redis": {
    "host": "localhost",
    "port": 6379,
    "password": "redis_password_2024"
  },
  "rabbitmq": {
    "host": "localhost",
    "port": 5672,
    "username": "smdvital",
    "password": "rabbitmq_password_2024",
    "vhost": "smdvital"
  },
  "monitoring": {
    "interval": 30,
    "alert_thresholds": {
      "redis_memory_usage": 80,
      "rabbitmq_queue_size": 1000,
      "connection_failures": 5,
      "response_time": 5.0
    },
    "email_alerts": {
      "enabled": false,
      "smtp_server": "smtp.gmail.com",
      "smtp_port": 587,
      "username": "your_email@gmail.com",
      "password": "your_app_password",
      "recipients": [
        "admin@smdvital.com",
        "devops@smdvital.com"
      ]
    }
  },
  "services": {
    "user_service": {
      "url": "http://user-service:8002",
      "health_endpoint": "/health"
    },
    "appointment_service": {
      "url": "http://appointment-service:8003",
      "health_endpoint": "/health"
    },
    "notification_service": {
      "url": "http://notification-service:8004",
      "health_endpoint": "/health"
    },
    "medical_records_service": {
      "url": "http://medical-records-service:8005",
      "health_endpoint": "/health"
    },
    "payment_service": {
      "url": "http://payment-service:8006",
      "health_endpoint": "/health"
    }
  },
  "circuit_breakers": {
    "user_service": {
      "failure_threshold": 5,
      "recovery_timeout": 60,
      "success_threshold": 3
    },
    "appointment_service": {
      "failure_threshold": 5,
      "recovery_timeout": 60,
      "success_threshold": 3
    },
    "notification_service": {
      "failure_threshold": 3,
      "recovery_timeout": 30,
      "success_threshold": 2
    }
  },
  "retry_policies": {
    "default": {
      "max_retries": 3,
      "base_delay": 1,
      "max_delay": 60,
      "strategy": "exponential",
      "jitter": true
    },
    "critical_operations": {
      "max_retries": 5,
      "base_delay": 2,
      "max_delay": 120,
      "strategy": "exponential",
      "jitter": true
    }
  },
  "security": {
    "encryption_key_file": "redis_encryption_key.key",
    "audit_retention_days": 30,
    "sensitive_data_patterns": [
      "email",
      "phone",
      "ssn",
      "credit_card",
      "password",
      "token",
      "api_key",
      "secret"
    ]
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "/var/log/smd-vital/monitoring.log",
    "max_size": "10MB",
    "backup_count": 5
  }
}







