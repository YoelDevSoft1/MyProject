# SMD Vital Auth Service - Environment Variables
# ================================================

# Database Configuration
DATABASE_URL=postgresql://smdvital:password@postgres:5432/smdvital

# JWT Configuration
JWT_SECRET=smd_vital_secret_key_2024_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback

# Service URLs
USER_SERVICE_URL=http://user-service:8002
NOTIFICATION_SERVICE_URL=http://notification-service:8004

# Logging
LOG_LEVEL=INFO

# CORS (Deshabilitado - manejado por Nginx)
# ALLOWED_ORIGINS=http://localhost:3001
# ALLOWED_CREDENTIALS=true

# Environment
ENVIRONMENT=development
DEBUG=true